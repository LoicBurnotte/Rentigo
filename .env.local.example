# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (platform secret — never replaces per-user stripe_account_id in the database)
STRIPE_SECRET_KEY=stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=stripe-publishable-key
STRIPE_WEBHOOK_SECRET=stripe-webhook-secret
# Connect: enable at https://dashboard.stripe.com/connect (test and live separately).
# Webhook endpoint: /api/stripe/webhooks — subscribe at least to checkout.session.completed,
# checkout.session.expired, and account.application.deauthorized.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000